# Copy this file to .env and adjust values as needed.
# docker-compose reads this automatically; nothing here is committed with real values.

# --- Database ---
DB_NAME=api_monitor
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# --- Backend ---
# SERVER_PORT only controls which HOST port the API is published on (the container
# always listens on 8080 internally - the frontend's nginx proxy targets it by that
# fixed internal port on the Docker network, so this does not change it).
SERVER_PORT=8080
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Auth ---
# REQUIRED. Generate a real one, e.g.:  openssl rand -base64 48
# docker-compose refuses to start the backend if this is left unset.
JWT_SECRET=replace-this-with-a-real-random-secret-before-running-anything-real
JWT_EXPIRATION_MS=86400000

# --- Email (forgot-password links) ---
# Optional. Leave MAIL_USERNAME/MAIL_PASSWORD blank and the reset link is just logged to
# the backend console instead of emailed - fine for local dev.
#
# Gmail setup: enable 2-Step Verification on the Google account, then create an App
# Password at https://myaccount.google.com/apppasswords. Use that 16-character password
# below, NOT the account's real password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Monitoring engine tunables ---
# These are the ones exposed through Docker Compose (see docker-compose.yml). Deeper
# internals (retry backoff, connect timeout, sweep timeout, log-history limits, the
# SLOW-vs-HEALTHY latency threshold, analytics window min/max bounds) have sane defaults
# in application.yml and aren't wired through Compose - if you need to tune one of those
# for a specific deployment, set it directly as a container environment variable.
MONITOR_SCHEDULER_FIXED_RATE_MS=15000
MONITOR_HEALTHCHECK_TIMEOUT_MS=5000
MONITOR_HEALTHCHECK_CONCURRENCY=8
MONITOR_HEALTHCHECK_DEFAULT_INTERVAL_S=60
MONITOR_HEALTHCHECK_MIN_INTERVAL_S=15
MONITOR_HEALTHCHECK_MAX_INTERVAL_S=3600
MONITOR_ANALYTICS_WINDOW_DAYS=30

# --- Frontend ---
FRONTEND_PORT=5173
