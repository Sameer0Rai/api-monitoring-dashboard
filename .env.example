# Copy this file to .env and adjust values as needed.
# docker-compose reads this automatically; nothing here is committed with real values.

# --- Database ---
DB_NAME=api_monitor
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# --- Backend ---
SERVER_PORT=8080
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Monitoring engine tunables ---
MONITOR_SCHEDULER_FIXED_RATE_MS=60000
MONITOR_HEALTHCHECK_TIMEOUT_MS=5000
MONITOR_HEALTHCHECK_CONCURRENCY=8

# --- Frontend ---
FRONTEND_PORT=5173
